<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>12.0</LangVersion>
        <Version>2.0.0</Version>
        <Authors>Arda Terekeci</Authors>
        <Company>Arda Terekeci</Company>
        <Description>A powerful .NET library for creating, reading, and updating JSON objects using a path-based API. Bounded, lossless JSON editing for .NET 8, 9, 10 and .NET 11 RC. Supports escaped paths, nested arrays and detached snapshots.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/adomorn/StructuredJson</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>json;path;dictionary;serialization;deserialization;dotnet;net8;net9;net10;net11</PackageTags>
        <PackageReleaseNotes>See CHANGELOG.md for release notes</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <Deterministic>true</Deterministic>
        <SourceLinkCreate>true</SourceLinkCreate>
        <SourceLinkOriginUrl>https://github.com/adomorn/StructuredJson</SourceLinkOriginUrl>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\icon.png" Pack="true" PackagePath="\" />
        <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
    </ItemGroup>


</Project>
